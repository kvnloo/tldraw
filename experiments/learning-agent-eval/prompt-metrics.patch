@@
 	logCompletedActions: boolean
+	logPromptMetrics: boolean
@@
 	logCompletedActions: false,
+	logPromptMetrics: false,
 }
@@
+	exportPromptMetrics(prompt: BaseAgentPrompt) {
+		const encoder = new TextEncoder()
+		const parts = Object.fromEntries(
+			Object.entries(prompt).map(([type, part]) => [
+				type,
+				encoder.encode(JSON.stringify(part)).byteLength,
+			])
+		)
+		const totalBytes = encoder.encode(JSON.stringify(prompt)).byteLength
+		return { totalBytes, parts }
+	}
+
+	logPromptMetrics(prompt: BaseAgentPrompt): void {
+		if (!this.$debugFlags.get().logPromptMetrics) return
+		console.log('[DEBUG] Prompt Metrics:', this.exportPromptMetrics(prompt))
+	}
+
